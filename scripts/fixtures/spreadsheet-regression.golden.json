        {
          "kind": "section",
          "text": "Resumo do mês"
        },
        {
          "kind": "table",
          "rows": [
            [
              "Total de Receitas",
              {
                "v": "=SUMIFS(Transações!E:E,Transações!D:D,\"Receita\")",
                "role": "formula",
                "format": "currency"
              }
            ],
            [
              "Total de Despesas",
              {
                "v": "=SUMIFS(Transações!E:E,Transações!D:D,\"Despesa\")",
                "role": "formula",
                "format": "currency"
              }
            ],
            [
              "Saldo do período",
              {
                "v": "=B4-B5",
                "role": "formula",
                "format": "currency"
              }
            ]
          ],
          "columns": [
            {
              "format": "text",
              "header": "Label"
            },
            {
              "format": "currency",
              "header": "Valor"
            }
          ],
          "headerless": true
        },
        {
          "kind": "spacer"
        },
        {
          "kind": "section",
          "text": "Orçamento por categoria"
        },
        {
          "kind": "table",
          "rows": [
            [
              "Moradia",
              1500,
              "=SUMIFS(Transações!$E:$E,Transações!$C:$C,A10,Transações!$D:$D,\"Despesa\")",
              "=B10-C10",
              "=IF([@Realizado]=0,\"N/A\",[@Realizado]/[@Orçado])"
            ],
            [
              "Alimentação",
              600,
              "=SUMIFS(Transações!$E:$E,Transações!$C:$C,A11,Transações!$D:$D,\"Despesa\")",
              "=B11-C11",
              "=IF([@Realizado]=0,\"N/A\",[@Realizado]/[@Orçado])"
            ],
            [
              "Transporte",
              300,
              "=SUMIFS(Transações!$E:$E,Transações!$C:$C,A12,Transações!$D:$D,\"Despesa\")",
              "=B12-C12",
              "=IF([@Realizado]=0,\"N/A\",[@Realizado]/[@Orçado])"
            ],
            [
              "Lazer",
              200,
              "=SUMIFS(Transações!$E:$E,Transações!$C:$C,A13,Transações!$D:$D,\"Despesa\")",
              "=B13-C13",
              "=IF([@Realizado]=0,\"N/A\",[@Realizado]/[@Orçado])"
            ],
            [
              "Saúde",
              350,
              "=SUMIFS(Transações!$E:$E,Transações!$C:$C,A14,Transações!$D:$D,\"Despesa\")",
              "=B14-C14",
              "=IF([@Realizado]=0,\"N/A\",[@Realizado]/[@Orçado])"
            ],
            [
              "Educação",
              200,
              "=SUMIFS(Transações!$E:$E,Transações!$C:$C,A15,Transações!$D:$D,\"Despesa\")",
              "=B15-C15",
              "=IF([@Realizado]=0,\"N/A\",[@Realizado]/[@Orçado])"
            ],
            [
              "Outros",
              150,
              "=SUMIFS(Transações!$E:$E,Transações!$C:$C,A16,Transações!$D:$D,\"Despesa\")",
              "=B16-C16",
              "=IF([@Realizado]=0,\"N/A\",[@Realizado]/[@Orçado])"
            ],
            [
              "Total",
              "=SUM(B10:B16)",
              "=SUM(C10:C16)",
              "=B17-C17",
              "=IF([@Realizado]=0,\"N/A\",[@Realizado]/[@Orçado])"
            ]
          ],
