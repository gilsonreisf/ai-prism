# Ambiente totalmente local. Copie para .env.local; não inclua credenciais reais.
LOCAL_DEV_MODE=1
DATABRICKS_HOST=<workspace_url>
DATABRICKS_USER_EMAIL=local-dev@databricks.com
DATABRICKS_USER_TOKEN=local-dev-token
APP_OWNER_EMAIL=local-dev@databricks.com

PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=ai_prism
PGUSER=ai_prism
PGPASSWORD=ai_prism
PGSSLMODE=disable

PORT=8000
LOCAL_PGVECTOR=1
HISTORY_RETRIEVAL=on

# Opcionais: preencha somente quando quiser testar integrações reais. O banco
# local e os Studios não dependem delas.
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# DATABRICKS_USER_TOKEN=dapi...
# SQL_WAREHOUSE_ID=
